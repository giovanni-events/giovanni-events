<section class="events" id="events" aria-labelledby="events-heading">
  <h2 class="section-heading" id="events-heading">Upcoming events</h2>

  {% if collections.upcomingEvents.length %}
  <div class="carousel" aria-roledescription="carousel" aria-label="Upcoming events">
    <ul class="carousel__track" tabindex="0" aria-label="Events, scroll for more">
      {% for event in collections.upcomingEvents %}
      {% set e = event.data %}
      <li class="carousel__slide" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ loop.length }}">
        <article class="event-card"{% if e.bg_color or e.highlight_color %} style="{% if e.bg_color %}--theme-bg: {{ e.bg_color }};{% endif %}{% if e.highlight_color %} --theme-highlight: {{ e.highlight_color }};{% endif %}"{% endif %}>
          <div class="event-card__info">
            <div class="event-card__when">
              <p class="event-card__day">{{ e.start | dayOfWeek }}</p>
              <p class="event-card__date">{{ e.start | monthDay }}</p>
              <p class="event-card__time">{{ e.start | timeRange(e.end_time) }}</p>
            </div>
            <div class="event-card__venue">
              <p class="event-card__venue-name">{{ e.venue_name }}</p>
              <p class="event-card__address">{{ e.venue_address | escape | nl2br | safe }}</p>
            </div>
            <h3 class="event-card__title">
              <a href="{{ event.url }}">
                <span class="event-card__line1">{{ e.header_line_1 }}</span>
                <span class="event-card__line2">{{ e.header_line_2 }}</span>
                <span class="event-card__subhead">{{ e.subhead }}</span>
              </a>
            </h3>
            <p class="event-card__desc">{{ e.short_description }}</p>
            {% if e.ticket_url %}
            <a class="event-card__tickets" href="{{ e.ticket_url }}">{{ e.button_text or "Buy tickets" }}</a>
            {% endif %}
            {% if e.performers.length %}
            <div class="event-card__performers">
              {% set performers = e.performers | byRole("Performer") %}
              {% set hosts = e.performers | byRole("Host") %}
              <ul>{% for p in performers %}<li>{{ p.name }}</li>{% endfor %}</ul>
              {% if hosts.length %}
              <p class="event-card__hosted">Hosted by</p>
              <ul>{% for p in hosts %}<li>{{ p.name }}</li>{% endfor %}</ul>
              {% endif %}
            </div>
            {% endif %}
          </div>
          <img class="event-card__poster" src="{{ e.poster }}" alt="{{ e.poster_alt }}">
        </article>
      </li>
      {% endfor %}
    </ul>
    {% if collections.upcomingEvents.length > 1 %}
    <button class="carousel__arrow carousel__arrow--prev" type="button" aria-label="Previous event"><span aria-hidden="true">‹</span></button>
    <button class="carousel__arrow carousel__arrow--next" type="button" aria-label="Next event"><span aria-hidden="true">›</span></button>
    {% endif %}
  </div>
  {% else %}
  <p class="events__empty">No upcoming events. Check back soon.</p>
  {% endif %}
</section>
